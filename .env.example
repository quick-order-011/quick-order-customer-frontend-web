# MenuService (ShopService) base. Defaults to the vite dev proxy (/api -> :3001).
VITE_API_BASE=/api

# AuthService base. Defaults to the vite dev proxy (/auth -> :3002/api).
VITE_AUTH_BASE=/auth

# GUEST identity sent to MenuService until an API gateway injects it from the
# guest JWT cookie. Must be a UUID v4 that exists as a shop user for menu reads.
VITE_GUEST_USER_ID=00000000-0000-4000-8000-000000000001

# Active menu id for the cafe. MenuService has no guest shopId→menu endpoint yet,
# so the guest page reads the menu from `?menu=<menuId>` or this fallback.
VITE_MENU_ID=
